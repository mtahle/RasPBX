#!/bin/bash

set -euo pipefail
trap '{ stty sane; printf "\n\nAborting\n\n"; exit 1; }' SIGINT SIGTERM

LOGFILE="/var/log/freepbx-install.log"
exec > >(tee -a "$LOGFILE") 2>&1

### CONFIGURABLE OPTIONS ###
DRY_RUN=false
ENABLE_OPUS=true
SECURE_SSH=true
CLEANUP=true

### FUNCTIONS ###
function log_info() {
  echo -e "[INFO] $*"
}

function run() {
  if $DRY_RUN; then
    echo "[DRY-RUN] $*"
  else
    eval "$@"
  fi
}

function secure_ssh() {
  if $SECURE_SSH; then
    log_info "Securing SSH configuration..."
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config
    grep -q '^PasswordAuthentication' /etc/ssh/sshd_config && \
      sed -i 's/^PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config || \
      echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config
    systemctl restart ssh
  fi
}

function install_opus_codec() {
  if ! $ENABLE_OPUS; then
    return
  fi
  log_info "Installing Opus codec support in Asterisk..."
  cd /usr/src/asterisk*
  make menuselect.makeopts
  menuselect/menuselect --enable codec_opus --enable res_format_attr_opus menuselect.makeopts
  make && make install
  asterisk -rx "module load codec_opus.so"
  asterisk -rx "module load res_format_attr_opus.so"
  asterisk -rx "core show translation" | grep opus
}

function configure_extensions_and_trunks() {
  log_info "Ensuring Opus, ulaw, alaw are allowed in PJSIP..."
  sed -i '/\[endpoint\]/,/^$/ s/^allow=.*/allow=opus,ulaw,alaw/' /etc/asterisk/pjsip.endpoint.conf || true
  fwconsole reload
}

function cleanup_installation() {
  if $CLEANUP; then
    log_info "Cleaning up temporary files and caches..."
    apt-get -y autoremove
    apt-get -y clean
    rm -rf /root/install
    rm -f /etc/profile.d/install-ps.sh
    rm -f /usr/src/asterisk*/sounds/*.tar.gz
  fi
}

### MAIN INSTALLATION FLOW ###
log_info "Starting enhanced FreePBX installation..."

secure_ssh

if [[ ! -x /usr/sbin/fwconsole ]]; then
  echo "fwconsole not found. Ensure FreePBX is installed before running this enhancement script."
  exit 1
fi

install_opus_codec
configure_extensions_and_trunks
cleanup_installation

log_info "Installation enhancements complete. Review $LOGFILE for details."
